# The keys a server's .env.local holds. Write .env.local on the server from the
# Vaultwarden item "<site> <ENV> .env.local". Values only: no logic. Never commit
# .env.local. See docs/settings.md in happiness/drupal-project.
#
# Put values in single quotes: then nothing in them is interpreted. Double quotes
# only for a value that has to end with a newline ("...\n").

# dev, test or prod.
DRUPAL_ENV=''

DB_NAME=''
DB_USER=''
DB_PASSWORD=''
# Optional, default localhost and 3306.
DB_HOST=''
DB_PORT=''

# Permanent on a live site, see docs/settings.md.
HASH_SALT=''
