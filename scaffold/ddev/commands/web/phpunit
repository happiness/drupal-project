#!/usr/bin/env bash
#ddev-silent-no-warn

## Description: Run PHPUnit from the docroot, as Drupal's functional tests need. Uses phpunit.xml if it exists, else phpunit.xml.dist
## Usage: phpunit [PHPUnit options]
## Example: "ddev phpunit", "ddev phpunit --testsuite unit" or "ddev phpunit --filter FooTest"
## HostWorkingDir: false

set -euo pipefail

config="${DDEV_APPROOT}/phpunit.xml"
[[ -f "$config" ]] || config="${DDEV_APPROOT}/phpunit.xml.dist"
[[ -f "$config" ]] || { echo "Neither phpunit.xml nor phpunit.xml.dist exists in ${DDEV_APPROOT}." >&2; exit 1; }

cd "${DDEV_APPROOT}/${DDEV_DOCROOT}"
exec "${DDEV_APPROOT}/vendor/bin/phpunit" --configuration "$config" "$@"
