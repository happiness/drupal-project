<?xml version="1.0" encoding="UTF-8"?>
<!--
  Committed and used by CI (the qa check, unit and kernel tests) and by `ddev phpunit`.
  For local changes, copy it to the ignored phpunit.xml. The values below are DDEV's:
  an environment variable of the same name wins, as CI's SIMPLETEST_DB does.
-->
<phpunit bootstrap="web/core/tests/bootstrap.php">
  <php>
    <env name="SIMPLETEST_BASE_URL" value="%DDEV_PROJECT_URL%"/>
    <env name="SIMPLETEST_DB" value="mysql://db:db@db/db"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="/tmp"/>
    <env name="BROWSERTEST_OUTPUT_BASE_URL" value="%DDEV_PROJECT_URL%"/>
  </php>
  <testsuites>
    <testsuite name="unit">
      <directory>./web/modules/custom/*/tests/src/Unit</directory>
    </testsuite>
    <testsuite name="kernel">
      <directory>./web/modules/custom/*/tests/src/Kernel</directory>
    </testsuite>
    <testsuite name="functional">
      <directory>./web/modules/custom/*/tests/src/Functional</directory>
    </testsuite>
  </testsuites>
</phpunit>
